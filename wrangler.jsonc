{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pikadai",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Keep the Worker's own console output queryable, but do not persist per-request
  // invocation logs: those carry request headers and the client IP. See docs/cloudflare.md.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "upload_source_maps": true,

  // The React build is served as static assets on the same origin as the API,
  // so no CORS is needed and the API has no separate public hostname.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Create the real database with `npm run db:create` and paste its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pikadai",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Per-IP rate limits. Keys live only in memory; nothing is persisted.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
  ],

  // Nightly purge of expired polls.
  "triggers": { "crons": ["17 3 * * *"] },
}
